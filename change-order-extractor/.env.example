# Copy this file to .env and fill in your values.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides
COX_GEMINI_MODEL=gemini-3.8-flash
COX_GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash
# Stronger models asked for a second opinion when a weaker (fallback) model disagrees
# with the rules on the total, CO number or date. "none" = never escalate
# (or use `cox extract --no-second-opinion`).
COX_GEMINI_ESCALATION_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
COX_REVIEW_THRESHOLD=0.75
# Confidence calibration table (fitted by `cox calibrate`). Empty = the packaged table,
# "none" = raw, uncalibrated scores.
COX_CALIBRATION_FILE=
COX_LLM_MAX_RETRIES=4
# Set to empty to disable the on-disk LLM cache
COX_LLM_CACHE_DIR=.cache/llm
